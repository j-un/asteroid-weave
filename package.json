{
  "name": "asteroid-weave",
  "version": "1.0.0",
  "description": "3D Space Endless Runner",
  "type": "module",
  "main": "dist/script.js",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "serve": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\""
  },
  "keywords": [
    "game",
    "three.js",
    "typescript",
    "3d"
  ],
  "author": "Jun Tanaka",
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
